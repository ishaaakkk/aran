# aran-web local configuration.
#
# Every value here is OPTIONAL. The defaults compiled into src/services/keycloak.ts
# are exactly the values below, and they match the Keycloak realm that
# `docker compose up -d` imports from keycloak/import/aran-realm.json. If you run
# the standard local stack you do not need a .env file at all.
#
# Copy to .env only when you need to point the SPA somewhere else — a Keycloak on
# another host, a differently-named realm, or a second client:
#
#     cp .env.example .env
#
# .env is gitignored. Never commit one.

# Base URL of the Keycloak server. No trailing slash.
VITE_KEYCLOAK_URL=http://localhost:8080

# Realm name. Must match `realm` in keycloak/import/aran-realm.json.
VITE_KEYCLOAK_REALM=aran

# Public client the SPA authenticates as. The realm also defines `aran-backend`,
# which is the backend's confidential client — do not use it here.
VITE_KEYCLOAK_CLIENT_ID=aran-web

# Demo mode: `true` makes the `demo` Keycloak user's traffic resolve against the
# in-memory scenario in src/services/demo/ instead of the backend, and shows the
# guided-tour hint on the login page. The identity alone is deliberately NOT enough —
# without this flag a real user named `demo` (or reachable at demo@example.com) keeps
# their own tenant instead of being shown a fabricated one.
#
# Off everywhere unless a run opts in, and no checked-in env file turns it on: run
# `npm run dev:demo` for a demo dev server, or pass VITE_DEMO=true to the build for a
# demo deployment. Setting it here (in your own .env) opts your whole local dev in.
VITE_DEMO=false

# Base URL of the user documentation the app links into (the "JDBC guide" link on a
# data product, …). Defaults to the published docs site; set it only when your
# deployment mirrors the docs somewhere else.
# VITE_DOCS_URL=https://dtak-upc.github.io/aran

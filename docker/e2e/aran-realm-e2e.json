{
  "realm": "aran-e2e",
  "enabled": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "displayName": "Aran",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "sslRequired": "external",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 7200,
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Aran platform administrator (cross-tenant operations). Not the same as a tenant OWNER — tenant roles live in the application database on Membership, not in Keycloak."
      }
    ]
  },
  "clients": [
    {
      "clientId": "aran-web",
      "name": "Aran Web",
      "description": "Public SPA client. Authorization-code + PKCE; no client secret. No client roles — application roles live on Membership.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5273"
      },
      "redirectUris": [
        "http://localhost:5273/*"
      ],
      "webOrigins": [
        "http://localhost:5273",
        "+"
      ],
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "firstName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "name",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "aran-backend",
      "name": "Aran backend service account",
      "description": "Machine credential so Aran's backend can create and manage users through its own admin UI. No human logs in through this client. Scoped to manage-users/view-users only — NOT a realm admin.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-backend-secret-change-in-prod",
      "protocol": "openid-connect"
    },
    {
      "clientId": "aran-cli",
      "name": "Aran scripted login",
      "description": "Public client for password-grant logins from scripts: the standalone smoke test and operator tooling. No browser flow — the SPA uses aran-web with PKCE; widening that client to direct grants would trade its whole PKCE posture for a test's convenience.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-aran-backend",
      "enabled": true,
      "serviceAccountClientId": "aran-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    },
